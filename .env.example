# ==============================================================================
# Grafana to Slack Headless Bot Configuration Template (.env.example)
# ==============================================================================

# --- Grafana Settings ---
# Primary Grafana URL (leave blank if configuring via Web UI)
GRAFANA_URL=

# Comma-separated list of Grafana URLs to monitor (optional, for multi-dashboard)
GRAFANA_URLS=

# Authentication credentials (bot logs in headlessly if user/pass is provided)
GRAFANA_USERNAME=
GRAFANA_PASSWORD=

# Alternative Auth 1: Service Account / Bearer Token (Recommended)
GRAFANA_API_TOKEN=

# Alternative Auth 2: Session Cookie (Bypasses SSO / Okta login)
GRAFANA_COOKIE=

# Rendering & Capture Settings
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
PAGE_LOAD_WAIT_SECONDS=8
GRAFANA_THEME=dark

# --- Slack Settings ---
# Slack Bot User OAuth Token (must start with xoxb-...)
# Required scopes: files:write, chat:write
SLACK_BOT_TOKEN=

# Target Slack Channel ID (e.g. C0123456789)
SLACK_CHANNEL_ID=

# Thread Timestamp (optional - post snapshots as replies in thread)
SLACK_THREAD_TS=

# Message template accompanying snapshots.
# Supports: {title}, {grafana_url}, {datetime}, {date}, {time}
SLACK_MESSAGE=📊 *Grafana Snapshot Alert* - {datetime}
SLACK_MESSAGE_TEMPLATE=📊 *{title}* - Snapshot at {datetime}\n<{grafana_url}|Open in Grafana>

# --- Scheduler Settings ---
# How often to run capture & upload cycle (in minutes)
SCHEDULE_INTERVAL_MINUTES=30
TIMEZONE=Asia/Kolkata
BOT_PAUSED=false

# --- Web UI Management Settings ---
WEB_HOST=0.0.0.0
WEB_PORT=5000
